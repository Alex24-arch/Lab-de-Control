function proyecto1()
% PROYECTO1  Consola interactiva para la simulacion parametrica de una
%            planta de primer orden (motor de CD).
%
% -----------------------------------------------------------------------
% TEORIA DE FONDO
% -----------------------------------------------------------------------
% Un motor de CD controlado por armadura, despreciando la inductancia La,
% se comporta como un sistema de PRIMER ORDEN cuya funcion de
% transferencia (velocidad angular / voltaje de armadura) es:
%
%       G(s) = KM / (tau*s + 1)
%
% donde los dos coeficientes se obtienen de los parametros fisicos:
%
%       KM  = Kt / (Ra*b + Kt*Kb)     <- ganancia de CD [rad/s por volt]
%       tau = Ra*J / (Ra*b + Kt*Kb)   <- constante de tiempo [s]
%
% El denominador comun, den = Ra*b + Kt*Kb, representa el amortiguamiento
% total del motor: la friccion mecanica (Ra*b) mas el frenado electrico
% que produce la fuerza contraelectromotriz (Kt*Kb). Si den fuera cero el
% motor no tendria nada que lo frene y el modelo dejaria de ser valido
% (seria un integrador puro), por eso el codigo lo valida explicitamente.
%
% Ante una ENTRADA ESCALON UNITARIO la respuesta analitica es:
%
%       y(t) = KM * (1 - exp(-t/tau))
%
% De esa expresion salen todos los valores caracteristicos que se grafican:
%
%   - Valor final esperado:  y(inf) = KM       (en la practica se evalua en
%                                               t = 5*tau, donde y = 99.3 %)
%   - y(tau) = 0.632*KM      -> definicion misma de la constante de tiempo
%   - Tiempo de asentamiento al 2 %:  ts = 4*tau
%        porque exp(-ts/tau) = 0.02  =>  ts = tau*ln(50) ~= 3.912*tau,
%        que por convencion se redondea a 4*tau
%   - Error de estado estacionario:  ess = referencia - y(inf) = 1 - KM
%        (la referencia es 1 porque la entrada es el escalon UNITARIO)
%
% -----------------------------------------------------------------------
% Uso:  >> proyecto1
%
% Compatible con MATLAB y GNU Octave.
% No requiere Control System Toolbox: la respuesta se calcula de forma
% analitica con la exponencial, no con la funcion step().
%
% EL-5409 Laboratorio de Control Automatico - Proyecto individual 1
% -----------------------------------------------------------------------

    % Estructura que guarda los 5 parametros fisicos.
    % Se inicializan en NaN ("Not a Number") para marcar que aun no tienen
    % valor; asi el programa distingue "sin definir" de "vale cero".
    P = struct('Kt', NaN, 'Ra', NaN, 'b', NaN, 'Kb', NaN, 'J', NaN);

    % Metadatos de cada parametro, usados para construir los menus y los
    % mensajes de validacion sin repetir codigo.
    % Columnas: {campo, descripcion, unidades, debe_ser_estrictamente_positivo}
    INFO = { ...
        'Kt', 'Constante de par del motor',        'N m/A',      true ; ...
        'Ra', 'Resistencia de armadura (estator)', 'Ohm',        true ; ...
        'b',  'Coeficiente de friccion del eje',   'N m s/rad',  false; ...
        'Kb', 'Constante de fuerza electromotriz', 'V s/rad',    false; ...
        'J',  'Momento de inercia (motor+carga)',  'kg m^2',     true };

    % Casos de prueba precargados. Cada uno ejercita una situacion distinta
    % del sistema y del grafico (ver CASOS.md para la explicacion completa).
    % Columnas: {etiqueta, que_demuestra, Kt, Ra, b, Kb, J}
    EJEMPLOS = { ...
      'A - Motor didactico', ...
      'KM muy pequena: el error de estado estacionario domina el grafico', ...
      0.01,   1.00, 0.10,   0.01,  0.01    ; ...
      ...
      'B - Error pequeno pero visible', ...
      'ess = 4.8 %, apenas sobre el umbral del 2 %: caso limite del grafico', ...
      0.05,   2.50, 0.02,   0.05,  0.02    ; ...
      ...
      'C - Seguimiento perfecto', ...
      'KM = 1 exacto: ess = 0, la salida alcanza la referencia', ...
      0.10,   1.00, 0.09,   0.10,  0.005   ; ...
      ...
      'D - Motor real (Maxon RE-25)', ...
      'KM >> 1: valores fisicos reales, la referencia queda aplastada en la escala', ...
      0.0234, 2.32, 1e-6,   0.0234, 1.07e-5; ...
      ...
      'E - Caso demostrativo', ...
      'tau = 0.5 s y ts = 2 s exactos: todas las marcas quedan bien separadas', ...
      0.60,   1.00, 0.40,   0.50,  0.35    };

    ultimo = [];   % guarda los resultados de la ultima simulacion (para exportar)

    banner();

    % ---- Bucle principal del menu ----------------------------------
    % El programa NO termina despues de simular: vuelve al menu para que
    % se puedan cambiar parametros y comparar respuestas sucesivas.
    while true
        mostrarMenu(P, INFO);
        op = strtrim(leerTexto('Seleccione una opcion: '));

        switch op
            case '1'
                P = ingresarTodos(P, INFO);
                ultimo = [];               % los resultados viejos ya no valen
            case '2'
                P = ingresarUno(P, INFO);
                ultimo = [];
            case '3'
                P = cargarEjemplo(P, EJEMPLOS);
                ultimo = [];
            case '4'
                mostrarParametros(P, INFO);
            case '5'
                if ~completos(P)
                    fprintf('\n  >> Faltan parametros por definir. Use la opcion 1 o la 3.\n');
                else
                    ultimo = simular(P);
                end
            case '6'
                if isempty(ultimo)
                    fprintf('\n  >> Primero debe ejecutar una simulacion (opcion 5).\n');
                else
                    exportar(ultimo);
                end
            case {'0', 'q', 'Q'}
                fprintf('\nFin del programa.\n\n');
                return;
            otherwise
                fprintf('\n  >> Opcion no valida.\n');
        end
    end
end

% ===================================================================
% INTERFAZ DE USUARIO
% ===================================================================
function banner()
    fprintf('\n');
    fprintf('===================================================================\n');
    fprintf('  EL-5409 Laboratorio de Control Automatico - Proyecto 1\n');
    fprintf('  Simulacion parametrica de un motor de CD\n');
    fprintf('  G(s) = KM / (tau*s + 1)\n');
    fprintf('===================================================================\n');
end

function mostrarMenu(P, INFO)
    if completos(P)
        estado = 'parametros completos';
    else
        estado = 'parametros INCOMPLETOS';
    end
    fprintf('\n-------------------------------------------------------------------\n');
    fprintf('  MENU PRINCIPAL   [%s]\n', estado);
    fprintf('-------------------------------------------------------------------\n');
    fprintf('   1) Ingresar todos los parametros\n');
    fprintf('   2) Modificar un parametro\n');
    fprintf('   3) Cargar un caso de prueba\n');
    fprintf('   4) Ver parametros actuales\n');
    fprintf('   5) Simular y graficar respuesta al escalon\n');
    fprintf('   6) Exportar resultados (CSV + PNG)\n');
    fprintf('   0) Salir\n');
    fprintf('-------------------------------------------------------------------\n');
    resumen(P, INFO);
end

function resumen(P, INFO)
% Linea compacta con el estado de los 5 parametros, visible siempre.
    linea = '   ';
    for k = 1:size(INFO,1)
        campo = INFO{k,1};
        v = P.(campo);
        if isnan(v)
            linea = [linea sprintf('%s=--  ', campo)];
        else
            linea = [linea sprintf('%s=%.4g  ', campo, v)];
        end
    end
    fprintf('%s\n', linea);
end

function mostrarParametros(P, INFO)
% Tabla detallada de parametros y, si estan completos, los coeficientes.
    fprintf('\n--- Parametros actuales ---\n');
    for k = 1:size(INFO,1)
        campo = INFO{k,1};
        v = P.(campo);
        if isnan(v)
            txt = '(sin definir)';
        else
            txt = sprintf('%.6g', v);
        end
        fprintf('  %-3s = %-14s %-34s [%s]\n', campo, txt, INFO{k,2}, INFO{k,3});
    end
    if completos(P)
        [KM, tau, ok, msg] = coeficientes(P);
        if ok
            fprintf('\n  den = Ra*b + Kt*Kb = %.6g\n', P.Ra*P.b + P.Kt*P.Kb);
            fprintf('  KM  = %.6g\n', KM);
            fprintf('  tau = %.6g s\n', tau);
            fprintf('  G(s) = %.6g / (%.6g s + 1)\n', KM, tau);
        else
            fprintf('\n  >> %s\n', msg);
        end
    end
end

% ===================================================================
% ENTRADA DE DATOS
% ===================================================================
function P = ingresarTodos(P, INFO)
    fprintf('\n--- Ingreso de parametros (ENTER conserva el valor actual) ---\n');
    for k = 1:size(INFO,1)
        P = pedirCampo(P, INFO, k);
    end
end

function P = ingresarUno(P, INFO)
% Permite cambiar un solo parametro: util para estudiar como afecta cada
% uno por separado (p.ej. subir J y ver como crece tau sin mover KM).
    fprintf('\n--- Modificar un parametro ---\n');
    for k = 1:size(INFO,1)
        fprintf('   %d) %-3s  %s\n', k, INFO{k,1}, INFO{k,2});
    end
    fprintf('   0) Cancelar\n');
    s = strtrim(leerTexto('Numero del parametro: '));
    k = str2double(s);
    if isnan(k) || k < 0 || k > size(INFO,1) || k ~= fix(k)
        fprintf('  >> Seleccion no valida.\n');
        return;
    end
    if k == 0
        return;
    end
    P = pedirCampo(P, INFO, k);
end

function P = pedirCampo(P, INFO, k)
% Solicita UN parametro y no avanza hasta que el valor sea valido.
% El bucle while es lo que hace que una entrada erronea no aborte el
% programa: se explica el problema y se vuelve a preguntar.
    campo   = INFO{k,1};
    desc    = INFO{k,2};
    unid    = INFO{k,3};
    estrict = INFO{k,4};

    while true
        if isnan(P.(campo))
            actual = 'sin definir';
        else
            actual = sprintf('%.6g', P.(campo));
        end
        msg = sprintf('  %s (%s) [%s] {actual: %s}: ', campo, desc, unid, actual);
        s = leerTexto(msg);

        % ENTER vacio: conservar el valor previo (si ya existe).
        if isempty(strtrim(s))
            if isnan(P.(campo))
                fprintf('    >> Este parametro aun no tiene valor, debe ingresarlo.\n');
                continue;
            else
                return;
            end
        end

        % str2double devuelve NaN si el texto no es un numero valido:
        % por eso se lee como texto y no con input(...) numerico, que
        % lanzaria un error y cortaria la ejecucion.
        v = str2double(s);
        [ok, err] = validar(v, campo, estrict);
        if ok
            P.(campo) = v;
            return;
        end
        fprintf('    >> %s\n', err);
    end
end

function P = cargarEjemplo(P, EJEMPLOS)
% Carga uno de los casos de prueba predefinidos.
    n = size(EJEMPLOS,1);
    fprintf('\n--- Casos de prueba ---\n');
    for k = 1:n
        fprintf('   %d) %s\n', k, EJEMPLOS{k,1});
        fprintf('      %s\n', EJEMPLOS{k,2});
        fprintf('      Kt=%g, Ra=%g, b=%g, Kb=%g, J=%g\n', ...
                EJEMPLOS{k,3}, EJEMPLOS{k,4}, EJEMPLOS{k,5}, EJEMPLOS{k,6}, EJEMPLOS{k,7});
    end
    fprintf('   0) Cancelar\n');

    s = strtrim(leerTexto('Opcion: '));
    k = str2double(s);
    if isnan(k) || k < 0 || k > n || k ~= fix(k) || k == 0
        fprintf('  >> Cancelado, se conservan los valores actuales.\n');
        return;
    end

    P = struct('Kt', EJEMPLOS{k,3}, 'Ra', EJEMPLOS{k,4}, 'b', EJEMPLOS{k,5}, ...
               'Kb', EJEMPLOS{k,6}, 'J',  EJEMPLOS{k,7});
    fprintf('  >> Caso "%s" cargado.\n', EJEMPLOS{k,1});
end

function s = leerTexto(msg)
% Lectura de texto compatible con MATLAB y Octave.
% Se usa input(...,'s') en lugar de input(...) numerico para que ninguna
% entrada del usuario pueda generar una excepcion.
    s = input(msg, 's');
    if ~ischar(s)
        s = '';
    end
end

% ===================================================================
% VALIDACION
% ===================================================================
function [ok, err] = validar(v, nombre, estrictamentePositivo)
% Verifica un valor y devuelve el motivo del rechazo en vez de lanzar
% error(), para que el bucle de ingreso pueda volver a preguntar.
%
% Criterios fisicos:
%   Kt, Ra, J  > 0   (un motor sin par, sin resistencia o sin inercia
%                     no tiene sentido fisico y ademas dividiria por cero)
%   b, Kb     >= 0   (pueden ser cero en un modelo idealizado, pero no
%                     ambos a la vez: eso se revisa en coeficientes())
    ok = false; err = '';

    if ~isnumeric(v) || ~isscalar(v) || isnan(v) || ~isreal(v) || ~isfinite(v)
        err = sprintf('%s debe ser un numero real finito.', nombre);
        return;
    end
    if estrictamentePositivo && v <= 0
        err = sprintf('%s debe ser estrictamente mayor que cero (se ingreso %g).', nombre, v);
        return;
    end
    if ~estrictamentePositivo && v < 0
        err = sprintf('%s no puede ser negativo (se ingreso %g).', nombre, v);
        return;
    end
    ok = true;
end

function r = completos(P)
% Verdadero solo si los 5 parametros ya tienen valor asignado.
    r = ~any(isnan([P.Kt, P.Ra, P.b, P.Kb, P.J]));
end

% ===================================================================
% CALCULO Y SIMULACION
% ===================================================================
function [KM, tau, ok, msg] = coeficientes(P)
% Calcula los coeficientes de G(s) = KM/(tau*s+1) a partir de los
% parametros fisicos del motor.
    KM = NaN; tau = NaN; ok = false; msg = '';

    % Amortiguamiento total: friccion mecanica + frenado por la FEM.
    den = P.Ra*P.b + P.Kt*P.Kb;

    % Si den = 0 el motor no tiene amortiguamiento: el modelo degenera en
    % un integrador y las formulas dividirian por cero.
    if den <= 0
        msg = sprintf(['El denominador (Ra*b + Kt*Kb) = %g debe ser mayor que cero. ' ...
                       'Revise b y Kb: no pueden ser ambos cero.'], den);
        return;
    end

    KM  = P.Kt / den;        % ganancia de CD
    tau = P.Ra*P.J / den;    % constante de tiempo
    ok  = true;
end

function R = simular(P)
% Calcula la respuesta al escalon unitario y todos los valores
% caracteristicos, los imprime y llama al graficador.
    R = [];
    [KM, tau, ok, msg] = coeficientes(P);
    if ~ok
        fprintf('\n  >> %s\n', msg);
        return;
    end

    % Ventana de tiempo: 6*tau garantiza que se vea el transitorio completo
    % (a 5*tau la respuesta ya llego al 99.3 %) con algo de margen a la
    % derecha para las anotaciones.
    tFin = 6*tau;
    t    = linspace(0, tFin, 2000);

    % Respuesta analitica del sistema de primer orden al escalon unitario.
    y = KM * (1 - exp(-t/tau));

    % --- Valores caracteristicos ---
    R.P      = P;
    R.KM     = KM;
    R.tau    = tau;
    R.t      = t;
    R.y      = y;
    R.yFinal = KM;                  % valor final esperado, y(inf)
    R.y5tau  = KM*(1 - exp(-5));    % valor en t = 5*tau  -> 99.3 % de KM
    R.yTau   = KM*(1 - exp(-1));    % valor en t = tau    -> 63.2 % de KM
    R.ts     = 4*tau;               % tiempo de asentamiento, banda del 2 %
    R.ess    = 1 - KM;              % error de estado estacionario (ref = 1)

    fprintf('\n===================================================================\n');
    fprintf('  RESULTADOS DE LA SIMULACION\n');
    fprintf('===================================================================\n');
    fprintf('  den = Ra*b + Kt*Kb           = %.6g\n\n', P.Ra*P.b + P.Kt*P.Kb);
    fprintf('  Funcion de transferencia:\n');
    fprintf('      G(s) = %.6g / (%.6g s + 1)\n\n', KM, tau);
    fprintf('  KM  (ganancia general)       = %.6g\n', KM);
    fprintf('  tau (constante de tiempo)    = %.6g s\n\n', tau);
    fprintf('  Valor final esperado         = %.6g\n', R.yFinal);
    fprintf('  y(t = tau  = %-10.4g s)  = %.6g   (63.2 %%)\n', tau, R.yTau);
    fprintf('  y(t = 5tau = %-10.4g s)  = %.6g   (99.3 %%)\n', 5*tau, R.y5tau);
    fprintf('  Tiempo de asentamiento (2 %%) = %.6g s\n', R.ts);
    fprintf('  Error de estado estacionario = %.6g\n', R.ess);
    fprintf('===================================================================\n');

    graficar(R);
end

% ===================================================================
% GRAFICO
% ===================================================================
function graficar(R)
% Dibuja la respuesta temporal con las cuatro anotaciones que pide el
% enunciado: valor final esperado, error de estado estacionario,
% valor en t = tau y tiempo de asentamiento al 2 %.
    tFin = R.t(end);
    figure('Name', 'Respuesta al escalon unitario', 'NumberTitle', 'off');
    hold on; grid on;

    % h y etiquetas acumulan solo los trazos que deben aparecer en la
    % leyenda; las lineas auxiliares se dibujan sin registrarse.
    h = []; etiquetas = {};

    % --- Entrada: escalon unitario (referencia) ---
    h(end+1) = plot([0 tFin], [1 1], '--', 'Color', [0.5 0.5 0.5], 'LineWidth', 1);
    etiquetas{end+1} = 'Entrada escalon unitario';

    % --- Respuesta del sistema ---
    h(end+1) = plot(R.t, R.y, 'b-', 'LineWidth', 2);
    etiquetas{end+1} = 'Respuesta y(t)';

    % --- (a) Valor final esperado, con la marca en t = 5*tau ---
    h(end+1) = plot([0 tFin], [R.yFinal R.yFinal], 'r--', 'LineWidth', 1.2);
    etiquetas{end+1} = sprintf('Valor final esperado = %.4g', R.yFinal);
    plot(5*R.tau, R.y5tau, 'ro', 'MarkerFaceColor', 'r', 'MarkerSize', 6);
    text(5*R.tau, R.y5tau, sprintf(' 5\\tau=%.3g s', 5*R.tau), ...
        'VerticalAlignment', 'bottom', 'HorizontalAlignment', 'right', ...
        'Color', 'r');

    % --- Banda del 2 % alrededor del valor final ---
    h(end+1) = plot([0 tFin], [1.02 1.02]*R.yFinal, ':', 'Color', [0.85 0.33 0.10]);
    etiquetas{end+1} = 'Banda \pm2 % del valor final';
    plot([0 tFin], [0.98 0.98]*R.yFinal, ':', 'Color', [0.85 0.33 0.10]);

    % --- (c) Valor de la respuesta en t = tau (63.2 % del valor final) ---
    h(end+1) = plot(R.tau, R.yTau, 'ks', 'MarkerFaceColor', 'g', 'MarkerSize', 8);
    etiquetas{end+1} = sprintf('y(\\tau) = %.4g (63.2 %%)', R.yTau);
    plot([R.tau R.tau], [0 R.yTau], 'k:');
    text(R.tau, R.yTau, sprintf('  \\tau = %.3g s', R.tau), 'VerticalAlignment', 'bottom');

    % --- (d) Tiempo de asentamiento al 2 % (ts = 4*tau) ---
    yTs = R.KM*(1 - exp(-R.ts/R.tau));
    h(end+1) = plot(R.ts, yTs, 'kd', 'MarkerFaceColor', 'm', 'MarkerSize', 8);
    etiquetas{end+1} = sprintf('t_s (2 %%) = %.4g s', R.ts);
    plot([R.ts R.ts], [0 yTs], 'k:');

    % --- (b) Error de estado estacionario, "cuando sea visible" ---
    % Se dibuja acotado entre la referencia y el valor final solo si la
    % separacion es apreciable en la escala; si no, se indica como texto.
    if abs(R.ess) > 0.02*max(1, abs(R.yFinal))
        xe = 0.80*tFin;
        plot([xe xe], [R.yFinal 1], 'k-', 'LineWidth', 1.5);
        plot(xe, 1, 'kv', 'MarkerFaceColor', 'k', 'MarkerSize', 5);
        plot(xe, R.yFinal, 'k^', 'MarkerFaceColor', 'k', 'MarkerSize', 5);
        text(xe, (R.yFinal+1)/2, sprintf('  e_{ss} = %.4g', R.ess), 'FontWeight', 'bold');
    else
        text(0.55*tFin, 0.15*max(1, R.yFinal), ...
             sprintf('e_{ss} = %.4g (no visible en la escala)', R.ess));
    end

    xlabel('Tiempo [s]');
    ylabel('Salida y(t)');
    title(sprintf('Respuesta al escalon unitario:  G(s) = %.4g / (%.4g s + 1)', R.KM, R.tau));
    legend(h, etiquetas, 'Location', 'southeast');
    xlim([0 tFin]);
    % El limite vertical considera tanto la referencia (1) como el valor
    % final, para que ambos queden dentro del grafico sea cual sea KM.
    ylim([0 1.15*max([1, R.yFinal])]);
    hold off;
    drawnow;
end

% ===================================================================
% EXPORTACION
% ===================================================================
function exportar(R)
% Guarda la curva en CSV (con encabezado de parametros) y la figura en PNG.
    base = strtrim(leerTexto('  Nombre base de los archivos [resultado]: '));
    if isempty(base)
        base = 'resultado';
    end

    archCsv = [base '.csv'];
    fid = fopen(archCsv, 'w');
    if fid < 0
        fprintf('  >> No se pudo crear %s\n', archCsv);
    else
        fprintf(fid, '# G(s) = %.10g / (%.10g s + 1)\n', R.KM, R.tau);
        fprintf(fid, '# Kt=%.10g, Ra=%.10g, b=%.10g, Kb=%.10g, J=%.10g\n', ...
                R.P.Kt, R.P.Ra, R.P.b, R.P.Kb, R.P.J);
        fprintf(fid, '# valor_final=%.10g, tau=%.10g, ts_2pct=%.10g, ess=%.10g\n', ...
                R.yFinal, R.tau, R.ts, R.ess);
        fprintf(fid, 't,y\n');
        % [R.t; R.y] arma una matriz 2xN; fprintf recorre por columnas,
        % de modo que escribe un par t,y por linea.
        fprintf(fid, '%.10g,%.10g\n', [R.t; R.y]);
        fclose(fid);
        fprintf('  >> Datos guardados en %s\n', archCsv);
    end

    archPng = [base '.png'];
    try
        print(gcf, archPng, '-dpng', '-r150');
        fprintf('  >> Grafico guardado en %s\n', archPng);
    catch
        fprintf('  >> No se pudo guardar la imagen (verifique que la figura este abierta).\n');
    end
end
